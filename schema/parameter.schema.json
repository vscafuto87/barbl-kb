{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barbl/kb/parameter.schema.json",
  "title": "Gruppo di parametri",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "group",
    "target",
    "values",
    "provisional",
    "principles"
  ],
  "properties": {
    "group": {
      "type": "string"
    },
    "target": {
      "enum": [
        "parameters",
        "mesocycle"
      ]
    },
    "ruleId": {
      "type": "string"
    },
    "values": {
      "type": "object"
    },
    "provisional": {
      "type": "boolean"
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "engineConstraints": {
      "type": "object"
    }
  }
}
